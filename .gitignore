# ---- Secrets (절대 커밋 금지) ----
.env
.env.*
!.env.example

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---- Testing / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Editors / OS ----
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Office temp files ----
~$*

# ---- Data ----
# 원자료(API 응답·대용량 원문)는 커밋하지 않음. 가공본(data/processed)과 수기 입력(data/manual)만 커밋
data/raw/*
!data/raw/.gitkeep
data/manual/*.pdf

# ---- Research build intermediates ----
research/*/_build/
