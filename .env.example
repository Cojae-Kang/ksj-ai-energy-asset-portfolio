# .env.example — 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 않습니다.
DART_API_KEY=
ECOS_API_KEY=
KRX_API_KEY=
DATA_GO_KR_API_KEY=
